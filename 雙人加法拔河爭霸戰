<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>雙人加法競賽：奇幻經典拔河爭霸戰</title>
    <style>
        :root {
            --pitch-bg: #1b5e20;
            --panel-bg: #FFFFFF;
            --btn-blue: #3498db;
            --btn-red: #e74c3c;
            --btn-purple: #E8DCF8;
            --btn-pink: #FFCCD2;
            --text-dark: #2c3e50;
            --active-border: #FF6B6B;
            --carry-bg: #FFEAA7;
            --wrong-color: #ff4757;
            --correct-color: #2ed573;
            --rope-gold: #c99355;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        html, body {
            background-color: #0d2818;
            height: 100%;
            width: 100%;
            font-family: "Comic Sans MS", "Arial Rounded MT Bold", "PingFang HK", "Microsoft JhengHei", sans-serif;
            color: #fff;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* 頂部控制列 */
        #top-bar {
            background: linear-gradient(180deg, rgba(10, 20, 15, 0.85) 0%, rgba(10, 20, 15, 0.6) 100%);
            backdrop-filter: blur(8px);
            padding: 4px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid rgba(255, 255, 255, 0.15);
            z-index: 100;
            flex-shrink: 0;
            height: clamp(36px, 4.5vh, 44px);
        }

        .logo {
            font-size: clamp(0.9rem, 1.3vw, 1.15rem);
            font-weight: 900;
            color: #ffeaa7;
            text-shadow: 0 2px 6px rgba(0,0,0,0.6);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .matchup-banner {
            font-size: clamp(0.72rem, 0.95vw, 0.88rem);
            color: #ffffff;
            background: rgba(255, 255, 255, 0.16);
            padding: 2px 12px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .controls {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .control-group {
            display: flex;
            align-items: center;
            gap: 5px;
            background: rgba(255, 255, 255, 0.18);
            padding: 2px 8px;
            border-radius: 12px;
        }

        .control-group label {
            font-size: clamp(0.7rem, 0.85vw, 0.8rem);
            font-weight: bold;
            color: #ffeaa7;
        }

        select {
            font-size: clamp(0.7rem, 0.85vw, 0.8rem);
            padding: 2px 4px;
            border-radius: 6px;
            border: none;
            outline: none;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            background: #ffffff;
            color: #333;
        }

        .btn-restart {
            background: linear-gradient(135deg, #ff4757, #ff6b81);
            color: white;
            border: none;
            padding: 3px 12px;
            border-radius: 12px;
            font-weight: bold;
            font-size: clamp(0.7rem, 0.85vw, 0.8rem);
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(255, 71, 87, 0.4);
            transition: transform 0.1s;
        }

        .btn-restart:active { transform: scale(0.95); }

        /* ===================================================
           上方加闊拔河運動場 (拔河擂台高度 : 答題區高度 = 1 : 2)
           =================================================== */
        #top-stadium {
            flex: 1; /* 高度佔 1 份 */
            min-height: 0;
            background: radial-gradient(circle at 50% 30%, #2e7d32 0%, #1b5e20 60%, #0d3813 100%);
            margin: 4px 10px 0 10px;
            border-radius: 14px;
            border: 2.5px solid #f1c40f;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 4px 14px 4px 14px;
            box-shadow: inset 0 0 25px rgba(0,0,0,0.5), 0 6px 18px rgba(0,0,0,0.4);
        }

        /* 擬真草皮壓痕與白石灰線條 */
        .field-ground {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: repeating-linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.035) 0px,
                rgba(255, 255, 255, 0.035) 45px,
                transparent 45px,
                transparent 90px
            );
            pointer-events: none;
        }

        .stadium-header {
            z-index: 10;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 0, 0, 0.45);
            padding: 1px 12px;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            flex-shrink: 0;
        }

        .stadium-title {
            font-size: clamp(0.75rem, 1vw, 0.86rem);
            font-weight: 900;
            color: #ffeaa7;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .stadium-status {
            font-size: clamp(0.72rem, 0.95vw, 0.82rem);
            color: #ffffff;
            font-weight: bold;
        }

        .tug-field {
            flex: 1;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
            min-height: 0;
            overflow: visible;
        }

        /* 拔河地面刻度與獲勝線 */
        .ground-scale {
            width: 100%;
            height: 18px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 160px; /* 預留三人隊伍寬度 */
        }

        .finish-line {
            position: absolute;
            top: -16px;
            bottom: -55px;
            width: 5px;
            z-index: 5;
            pointer-events: none;
        }

        .finish-line.left {
            left: 160px;
            background: repeating-linear-gradient(to bottom, #3498db, #3498db 8px, white 8px, white 16px);
            box-shadow: 0 0 12px rgba(52, 152, 219, 0.9);
        }

        .finish-line.right {
            right: 160px;
            background: repeating-linear-gradient(to bottom, #e74c3c, #e74c3c 8px, white 8px, white 16px);
            box-shadow: 0 0 12px rgba(231, 76, 60, 0.9);
        }

        .finish-tag {
            position: absolute;
            top: -15px;
            font-size: 0.6rem;
            font-weight: 900;
            padding: 1px 4px;
            border-radius: 3px;
            color: #fff;
            white-space: nowrap;
        }
        .finish-line.left .finish-tag { right: 8px; background: #2980b9; }
        .finish-line.right .finish-tag { left: 8px; background: #c0392b; }

        .center-line {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            top: -16px;
            bottom: -55px;
            width: 3px;
            background: rgba(255, 255, 255, 0.85);
            z-index: 5;
            pointer-events: none;
        }

        .center-label {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.62rem;
            font-weight: 900;
            color: #ffeaa7;
            background: rgba(0,0,0,0.65);
            padding: 1px 6px;
            border-radius: 4px;
            white-space: nowrap;
            z-index: 6;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .scale-ticks {
            position: absolute;
            left: 160px;
            right: 160px;
            height: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 4;
        }

        .tick-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(0, 0, 0, 0.4);
            transition: all 0.25s;
        }

        .tick-dot.active {
            background: #f1c40f;
            transform: scale(1.6);
            box-shadow: 0 0 10px #f1c40f;
        }

        /* 拔河戰隊與粗麻繩舞台 */
        .teams-and-rope-wrap {
            position: relative;
            width: 100%;
            height: 58px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
        }

        /* 拔河戰隊（三人陣列） */
        .puller-team {
            position: absolute;
            width: 155px;
            height: 56px;
            z-index: 12;
            display: flex;
            align-items: flex-end;
            pointer-events: none;
        }

        .puller-team.left {
            left: 5px;
            justify-content: flex-start;
        }

        .puller-team.right {
            right: 5px;
            justify-content: flex-start;
            flex-direction: row-reverse;
        }

        .team-meta {
            position: absolute;
            top: -6px;
            display: flex;
            align-items: center;
            gap: 4px;
            z-index: 15;
        }
        .puller-team.left .team-meta { left: 4px; }
        .puller-team.right .team-meta { right: 4px; flex-direction: row-reverse; }

        .team-name-badge {
            font-size: 0.65rem;
            font-weight: 900;
            padding: 2px 7px;
            border-radius: 6px;
            color: #fff;
            white-space: nowrap;
            box-shadow: 0 2px 5px rgba(0,0,0,0.4);
            display: flex;
            align-items: center;
            gap: 3px;
        }
        .badge-p1 { background: linear-gradient(135deg, #2980b9, #3498db); border: 1px solid #74b9ff; }
        .badge-p2 { background: linear-gradient(135deg, #c0392b, #e74c3c); border: 1px solid #ff7675; }

        /* 三名隊員排布與真實拔河深後仰角度 */
        .team-members-row {
            display: flex;
            align-items: flex-end;
            width: 100%;
            height: 100%;
            position: relative;
        }

        .character-unit {
            position: relative;
            width: 48px;
            height: 52px;
            flex-shrink: 0;
            margin-right: -10px; /* 隊員前後緊扣重疊 */
            transition: transform 0.2s ease;
        }

        .puller-team.right .character-unit {
            margin-right: 0;
            margin-left: -10px;
            transform: scaleX(-1); /* 紅隊全隊鏡像轉向左邊拉 */
        }

        /* 拔河時身體發力後仰動畫 */
        .puller-team.strain-left .character-unit {
            animation: strainHeave 0.4s ease-in-out;
        }
        .puller-team.strain-right .character-unit {
            animation: strainHeave 0.4s ease-in-out;
        }

        @keyframes strainHeave {
            0% { transform: rotate(0deg); }
            50% { transform: rotate(-10deg) translate(-4px, 2px); }
            100% { transform: rotate(0deg); }
        }

        .puller-team.right.strain-right .character-unit {
            animation: strainHeaveRight 0.4s ease-in-out;
        }
        @keyframes strainHeaveRight {
            0% { transform: scaleX(-1) rotate(0deg); }
            50% { transform: scaleX(-1) rotate(-10deg) translate(-4px, 2px); }
            100% { transform: scaleX(-1) rotate(0deg); }
        }

        /* 汗珠特效 */
        .sweat-drop {
            position: absolute;
            top: 2px;
            right: 8px;
            font-size: 0.75rem;
            opacity: 0;
            pointer-events: none;
        }
        .show-sweat .sweat-drop {
            animation: sweatPop 0.8s ease forwards;
        }
        @keyframes sweatPop {
            0% { opacity: 0; transform: translateY(0); }
            30% { opacity: 1; transform: translateY(-4px) scale(1.2); }
            100% { opacity: 0; transform: translateY(6px); }
        }

        /* 擬真貫穿式粗麻繩 */
        .rope-assembly {
            position: absolute;
            left: 50%;
            width: 140%;
            margin-left: -70%;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.38s cubic-bezier(0.25, 1, 0.5, 1);
            z-index: 8;
            pointer-events: none;
        }

        .rope-body {
            width: 100%;
            height: 12px;
            background: repeating-linear-gradient(
                55deg,
                #b08968,
                #b08968 10px,
                #7f5539 10px,
                #7f5539 20px
            );
            border-radius: 6px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.6), inset 0 2px 2px rgba(255,255,255,0.2);
            position: relative;
            border: 1px solid #4a3525;
        }

        /* 中央紅絲帶標記 (立體垂墜布條) */
        .rope-marker {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            z-index: 20;
        }

        .marker-clamp {
            width: 12px;
            height: 16px;
            background: #f1c40f;
            border: 1.5px solid #d35400;
            border-radius: 2px;
            box-shadow: 0 0 5px rgba(241, 196, 15, 0.8);
        }

        .marker-ribbon-tails {
            width: 18px;
            height: 28px;
            background: linear-gradient(180deg, #e74c3c 0%, #c0392b 100%);
            clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 50% 80%, 0% 100%);
            border: 1px solid #fff;
            box-shadow: 0 0 10px rgba(231, 76, 60, 0.9);
            animation: ribbonSway 1.4s infinite ease-in-out alternate;
        }

        @keyframes ribbonSway {
            0% { transform: rotate(-5deg); }
            100% { transform: rotate(5deg) scale(1.06); }
        }

        @keyframes ropePullShakeLeft {
            0% { transform: translateX(var(--cur-shift)); }
            40% { transform: translateX(calc(var(--cur-shift) - 20px)) rotate(-0.5deg); }
            70% { transform: translateX(calc(var(--cur-shift) - 14px)) rotate(0.3deg); }
            100% { transform: translateX(var(--cur-shift)); }
        }

        @keyframes ropePullShakeRight {
            0% { transform: translateX(var(--cur-shift)); }
            40% { transform: translateX(calc(var(--cur-shift) + 20px)) rotate(0.5deg); }
            70% { transform: translateX(calc(var(--cur-shift) + 14px)) rotate(-0.3deg); }
            100% { transform: translateX(var(--cur-shift)); }
        }

        .pull-anim-left { animation: ropePullShakeLeft 0.38s ease-out; }
        .pull-anim-right { animation: ropePullShakeRight 0.38s ease-out; }

        /* 局勢進度量條 */
        .meter-container {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 6px;
            padding: 2px 10px;
            display: flex;
            flex-direction: column;
            gap: 2px;
            z-index: 10;
            flex-shrink: 0;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .meter-bar-track {
            height: 6px;
            background: #141e24;
            border-radius: 3px;
            overflow: hidden;
            display: flex;
            position: relative;
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        .meter-fill-blue {
            height: 100%;
            background: linear-gradient(90deg, #3498db, #54a0ff);
            transition: width 0.35s ease;
        }

        .meter-fill-red {
            height: 100%;
            background: linear-gradient(90deg, #ff6b6b, #ee5253);
            transition: width 0.35s ease;
        }

        .meter-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.68rem;
            font-weight: bold;
        }

        /* ===================================================
           下方雙人作答區 (拔河擂台高度 : 答題區高度 = 1 : 2)
           =================================================== */
        #game-stage {
            flex: 2; /* 高度佔 2 份，精準維持 1 : 2 */
            min-height: 0;
            display: flex;
            flex-direction: row;
            padding: 6px 10px;
            gap: 10px;
            overflow: hidden;
            position: relative;
        }

        .player-panel {
            flex: 1;
            background: rgba(255, 255, 255, 0.98);
            border-radius: 14px;
            color: var(--text-dark);
            display: flex;
            flex-direction: column;
            padding: 8px 10px;
            position: relative;
            box-shadow: 0 6px 18px rgba(0,0,0,0.3);
            border: 3.5px solid;
            min-width: 0;
            z-index: 5;
        }

        #panel-1 { border-color: var(--btn-blue); }
        #panel-2 { border-color: var(--btn-red); }

        .player-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2px;
            padding-bottom: 3px;
            border-bottom: 1.5px dashed #dcdde1;
            flex-shrink: 0;
        }

        .player-title {
            font-size: clamp(0.92rem, 1.15vw, 1.05rem);
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        #panel-1 .player-title { color: #2980b9; }
        #panel-2 .player-title { color: #c0392b; }

        .player-timer {
            font-size: clamp(0.7rem, 0.85vw, 0.8rem);
            font-weight: bold;
            padding: 2px 7px;
            border-radius: 6px;
            background: #e8f4fd;
            color: #2980b9;
        }

        .player-timer.fast { background: #e8f8f5; color: #27ae60; }
        .player-timer.slow { background: #fdf2e9; color: #d35400; }

        /* ===================================================
           直式闊度 : 數字鍵盤闊度 = 2 : 1，且兩者緊靠
           =================================================== */
        .math-section {
            flex: 1;
            display: flex;
            flex-direction: row;
            align-items: center;
            min-height: 0;
            width: 100%;
            gap: clamp(6px, 1vw, 12px);
            padding: 4px 0;
        }

        .math-left-col {
            flex: 2; /* 闊度佔 2 份 */
            min-width: 0;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: flex-end; /* 直式靠右對齊貼近鍵盤 */
            justify-content: center;
            padding-right: 2px;
        }

        .math-right-col {
            flex: 1; /* 闊度佔 1 份 */
            min-width: 0;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: flex-start; /* 鍵盤靠左對齊貼近直式 */
            justify-content: center;
            padding-left: 2px;
        }

        .math-grid {
            display: flex;
            flex-direction: column;
            gap: 3px;
            align-items: flex-end;
            justify-content: center;
        }

        .math-row {
            display: flex;
            gap: 4px;
            justify-content: flex-end;
            width: 100%;
        }

        .math-cell {
            width: clamp(34px, 4.2vw, 56px);
            height: clamp(34px, 4.2vw, 56px);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: clamp(1.4rem, 2.5vw, 2.3rem);
            font-weight: bold;
            border-radius: 8px;
            position: relative;
        }

        .header-cell {
            font-size: clamp(0.72rem, 1.0vw, 0.95rem);
            color: #7f8c8d;
            height: clamp(16px, 2vh, 22px);
            font-weight: bold;
        }

        .symbol-cell {
            color: #555;
            justify-content: flex-start;
        }

        .divider-row {
            border-bottom: 3.5px solid var(--text-dark);
            margin: 2px 0;
            width: 100%;
        }

        .carry-btn {
            background-color: #f1f2f6;
            border: 2px dashed #a4b0be;
            color: #747d8c;
            font-size: clamp(0.7rem, 0.9vw, 0.85rem);
            border-radius: 50%;
            width: 80%;
            height: 80%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s;
            font-weight: bold;
        }

        .carry-btn.active-carry {
            background-color: var(--carry-bg);
            border: 2px solid #f39c12;
            color: #d35400;
            font-size: clamp(1.15rem, 1.6vw, 1.45rem);
        }

        .answer-box {
            border: 2.5px dashed #ced6e0;
            background-color: #fafafa;
            cursor: pointer;
            transition: all 0.15s;
        }

        .answer-box.selected {
            border: 2.5px solid var(--active-border) !important;
            background-color: #ffffff !important;
            box-shadow: 0 0 6px rgba(255, 107, 107, 0.45);
        }

        .answer-box.filled {
            border-style: solid;
            border-color: #70a1ff;
            background-color: #f1f6ff;
        }

        .cell-wrong {
            border: 2.5px solid var(--wrong-color) !important;
            background-color: #ffe6e6 !important;
            color: var(--wrong-color) !important;
        }

        .cell-correct {
            border: 2.5px solid var(--correct-color) !important;
            background-color: #e8f8f5 !important;
            color: var(--correct-color) !important;
        }

        /* 數字小鍵盤 */
        .numpad {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 4px;
            width: 100%;
            max-width: 155px;
        }

        .numpad-btn {
            background-color: var(--btn-purple);
            border: 1.5px solid #c9b3f0;
            border-radius: 7px;
            height: clamp(28px, 4.4vh, 42px);
            font-size: clamp(1.0rem, 1.4vw, 1.35rem);
            font-weight: bold;
            color: var(--text-dark);
            box-shadow: 0 2px 0 #c9b3f0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.1s;
        }

        .numpad-btn:active {
            transform: translateY(2px);
            box-shadow: 0 0 0 #c9b3f0;
        }

        .numpad-btn.btn-clear {
            background-color: var(--btn-pink);
            border-color: #f7a09c;
            box-shadow: 0 2px 0 #f7a09c;
            font-size: clamp(0.75rem, 0.95vw, 0.9rem);
        }

        .numpad-btn.btn-submit-key {
            background-color: #2ed573;
            border-color: #26af5f;
            color: white;
            box-shadow: 0 2px 0 #208b4b;
            font-size: clamp(0.78rem, 0.98vw, 0.92rem);
        }

        .numpad-btn.btn-retry-mode {
