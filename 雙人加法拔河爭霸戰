        constructor(id) {
            this.id = id;
            this.gridEl = document.getElementById(`grid-${id}`);
            this.numpadEl = document.getElementById(`numpad-${id}`);
            this.chanceEl = document.getElementById(`chance-${id}`);
            this.timerEl = document.getElementById(`timer-${id}`);
            this.submitBtn = null;

            this.num1 = [];
            this.num2 = [];
            this.carries = [];
            this.answers = [];
            this.carryErrors = [];
            this.ansErrors = [];

            this.currentSelectedCol = 0;
            this.modifyChances = 1;
            this.isDisplayingAnswer = false;

            this.startTime = null;
            this.timerInterval = null;
            this.elapsedSeconds = 0;

            this.initNumpad();
            this.generateNewQuestion();
        }

        initNumpad() {
            this.numpadEl.innerHTML = '';
            const layout = [1, 2, 3, 4, 5, 6, 7, 8, 9, "清除", 0, "提交"];
            layout.forEach(item => {
                const btn = document.createElement('div');
                btn.className = 'numpad-btn';

                if (item === "清除") {
                    btn.classList.add('btn-clear');
                    btn.textContent = item;
                    btn.addEventListener('pointerdown', (e) => {
                        e.preventDefault();
                        Sound.click();
                        this.handleKeypad(item);
                    });
                } else if (item === "提交") {
                    btn.classList.add('btn-submit-key');
                    btn.textContent = "提交";
                    this.submitBtn = btn;
                    btn.addEventListener('pointerdown', (e) => {
                        e.preventDefault();
                        this.handleActionClick();
                    });
                } else {
                    btn.textContent = item;
                    btn.addEventListener('pointerdown', (e) => {
                        e.preventDefault();
                        Sound.click();
                        this.handleKeypad(item);
                    });
                }
                this.numpadEl.appendChild(btn);
            });
        }

        startTimer() {
            if (this.timerInterval) clearInterval(this.timerInterval);
            this.startTime = Date.now();
            this.timerInterval = setInterval(() => {
                let diff = (Date.now() - this.startTime) / 1000;
                this.elapsedSeconds = diff;
                this.timerEl.textContent = `用時: ${diff.toFixed(1)}s`;
                if (diff <= 6.0) {
                    this.timerEl.className = 'player-timer fast';
                } else {
                    this.timerEl.className = 'player-timer slow';
                }
            }, 100);
        }

        stopTimer() {
            if (this.timerInterval) {
                clearInterval(this.timerInterval);
                this.timerInterval = null;
            }
        }

        generateNewQuestion() {
            if (tugState.isGameOver) return;

            let lvl = matchConfig.level;
            this.num1 = [];
            this.num2 = [];
            this.carries = Array(lvl + 1).fill(0); 
            this.answers = Array(lvl).fill(null);
            this.carryErrors = Array(lvl + 1).fill(false);
            this.ansErrors = Array(lvl).fill(false);
            this.modifyChances = 1;
            this.isDisplayingAnswer = false;
            this.currentSelectedCol = 0;

            let found = false;
            let attempts = 0;

            while (!found && attempts < 10000) {
                attempts++;
                let h1 = 2 + Math.floor(Math.random() * 8);
                let h2 = 2 + Math.floor(Math.random() * 8);

                let low1 = [];
                let low2 = [];
                for (let i = 0; i < lvl - 1; i++) {
                    low1.push(Math.floor(Math.random() * 10));
                    low2.push(Math.floor(Math.random() * 10));
                }

                let val1 = h1 * Math.pow(10, lvl - 1);
                let val2 = h2 * Math.pow(10, lvl - 1);
                for (let i = 0; i < lvl - 1; i++) {
                    val1 += low1[i] * Math.pow(10, i);
                    val2 += low2[i] * Math.pow(10, i);
                }

                let totalSum = val1 + val2;

                if (totalSum < Math.pow(10, lvl)) {
                    let d1_arr = [...low1, h1];
                    let d2_arr = [...low2, h2];

                    let hasCarry = false;
                    let carryTemp = 0;
                    for (let i = 0; i < lvl; i++) {
                        if (d1_arr[i] + d2_arr[i] + carryTemp > 9) {
                            hasCarry = true;
                        }
                        carryTemp = Math.floor((d1_arr[i] + d2_arr[i] + carryTemp) / 10);
                    }

                    if (hasCarry) {
                        this.num1 = d1_arr;
                        this.num2 = d2_arr;
                        found = true;
                    }
                }
            }

            if (this.submitBtn) {
                this.submitBtn.className = 'numpad-btn btn-submit-key';
                this.submitBtn.textContent = "提交";
            }
            this.chanceEl.textContent = "剩餘修改機會：1 次";
            this.renderGrid();
            this.startTimer();
        }

        handleKeypad(val) {
            if (this.isDisplayingAnswer || tugState.isGameOver) return;

            if (val === "清除") {
                this.answers[this.currentSelectedCol] = null;
                this.ansErrors[this.currentSelectedCol] = false;
            } else if (typeof val === 'number') {
                this.answers[this.currentSelectedCol] = val;
                this.ansErrors[this.currentSelectedCol] = false;

                if (this.currentSelectedCol < matchConfig.level - 1) {
                    this.currentSelectedCol++;
                }
            }
            this.renderGrid();
        }

        toggleCarry(col) {
            if (this.isDisplayingAnswer || tugState.isGameOver) return;
            Sound.click();
            this.carries[col] = (this.carries[col] === 1) ? 0 : 1;
            this.carryErrors[col] = false;
            this.renderGrid();
        }

        renderGrid() {
            this.gridEl.innerHTML = '';
            let maxCol = matchConfig.level;
            let rows = [[], [], [], [], [], []];

            for (let c = maxCol; c >= 0; c--) {
                let isSymbolCol = (c === maxCol);

                // 1. 數位標籤
                let hCell = document.createElement('div');
                hCell.className = 'math-cell header-cell';
                hCell.textContent = isSymbolCol ? "" : PLACE_LABELS[c];
                rows[0].push(hCell);

                // 2. 進位按鈕
                let carryCell = document.createElement('div');
                carryCell.className = 'math-cell';
                if (!isSymbolCol && c > 0) {
                    let isCarried = this.carries[c] === 1;
                    let carryBtn = document.createElement('button');
                    carryBtn.className = 'carry-btn' + (isCarried ? ' active-carry' : '');
                    carryBtn.textContent = isCarried ? "1" : "進位";
                    carryBtn.onclick = () => this.toggleCarry(c);

                    if (this.carryErrors[c]) {
                        carryBtn.classList.add('cell-wrong');
                    } else if (this.isDisplayingAnswer && isCarried) {
                        carryBtn.classList.add('cell-correct');
                    }
                    carryCell.appendChild(carryBtn);
                }
                rows[1].push(carryCell);

                // 3. 被加數
                let n1Cell = document.createElement('div');
                n1Cell.className = 'math-cell';
                n1Cell.textContent = !isSymbolCol ? this.num1[c] : "";
                rows[2].push(n1Cell);

                // 4. 加數與 '+'
                let n2Cell = document.createElement('div');
                n2Cell.className = 'math-cell';
                if (isSymbolCol) {
                    n2Cell.textContent = "+";
                    n2Cell.classList.add('symbol-cell');
                } else {
                    n2Cell.textContent = this.num2[c] !== undefined ? this.num2[c] : "";
                }
                rows[3].push(n2Cell);

                // 5. 答案填寫格
                let ansCell = document.createElement('div');
                ansCell.className = 'math-cell';
                if (!isSymbolCol) {
                    let aBox = document.createElement('div');
                    aBox.className = 'math-cell answer-box';
                    if (this.answers[c] !== null && this.answers[c] !== undefined) {
                        aBox.textContent = this.answers[c];
                        aBox.classList.add('filled');
                    }
                    if (this.currentSelectedCol === c && !this.isDisplayingAnswer) {
                        aBox.classList.add('selected');
                    }

                    aBox.onclick = () => {
                        if (this.isDisplayingAnswer || tugState.isGameOver) return;
                        this.currentSelectedCol = c;
                        this.renderGrid();
                    };

                    if (this.ansErrors[c]) {
                        aBox.classList.add('cell-wrong');
                    } else if (this.isDisplayingAnswer) {
                        aBox.classList.add('cell-correct');
                    }
                    ansCell.appendChild(aBox);
                }
                rows[5].push(ansCell);
            }

            rows.forEach((rowEls, idx) => {
                if (idx === 4) {
                    let divLine = document.createElement('div');
                    divLine.className = 'divider-row';
                    this.gridEl.appendChild(divLine);
                } else {
                    let rowDiv = document.createElement('div');
                    rowDiv.className = 'math-row';
                    rowEls.forEach(el => rowDiv.appendChild(el));
                    this.gridEl.appendChild(rowDiv);
                }
            });
        }

        handleActionClick() {
            if (tugState.isGameOver) return;
            if (this.isDisplayingAnswer) {
                this.generateNewQuestion();
                return;
            }
            this.submitAndVerify();
        }

        submitAndVerify() {
            let correctCarries = Array(matchConfig.level + 1).fill(0);
            let correctDigits = Array(matchConfig.level).fill(0);
            let cTemp = 0;
            for (let i = 0; i < matchConfig.level; i++) {
                correctCarries[i] = cTemp;
                let sum = (this.num1[i] || 0) + (this.num2[i] || 0) + cTemp;
                correctDigits[i] = sum % 10;
                cTemp = sum > 9 ? 1 : 0;
            }
            correctCarries[matchConfig.level] = cTemp;

            let hasError = false;
            this.ansErrors = Array(matchConfig.level).fill(false);
            this.carryErrors = Array(matchConfig.level + 1).fill(false);

            // 未填寫完整一律定為答錯
            for (let i = 0; i < matchConfig.level; i++) {
                if (this.answers[i] === null || this.answers[i] === undefined || this.answers[i] !== correctDigits[i]) {
                    this.ansErrors[i] = true;
                    hasError = true;
                }
                if (i > 0 && this.carries[i] !== correctCarries[i]) {
                    this.carryErrors[i] = true;
                    hasError = true;
                }
            }

            if (!hasError) {
                this.stopTimer();
                Sound.correct();

                this.chanceEl.textContent = "💪 答對了！用力往己方拉動 1 格！";
                applyTugMove(this.id, +1);

                this.renderGrid();

                if (!tugState.isGameOver) {
                    if (this.submitBtn) this.submitBtn.classList.add('disabled');
                    setTimeout(() => {
                        this.generateNewQuestion();
                    }, 950);
                }
            } else {
                Sound.wrong();
                let activePanel = document.getElementById(`panel-${this.id}`);
                activePanel.classList.add('shake');
                setTimeout(() => activePanel.classList.remove('shake'), 400);

                if (this.modifyChances > 0) {
                    this.modifyChances--;
                    this.chanceEl.textContent = "答案有誤（或未填寫完整）！剩餘修改機會：0 次";
                    if (this.submitBtn) {
                        this.submitBtn.textContent = "重交";
                        this.submitBtn.classList.add('btn-retry-mode');
                    }
                    for (let i = 0; i < matchConfig.level; i++) {
                        if (this.ansErrors[i]) {
                            this.currentSelectedCol = i;
                            break;
                        }
                    }
                    this.renderGrid();
                } else {
                    this.stopTimer();
                    this.isDisplayingAnswer = true;
                    this.ansErrors = Array(matchConfig.level).fill(false);
                    this.carryErrors = Array(matchConfig.level + 1).fill(false);

                    this.answers = correctDigits;
                    this.carries = correctCarries;

                    this.chanceEl.textContent = "⚠️ 答錯失守！標記被對方拉走 1 格！";
                    applyTugMove(this.id, -1);

                    if (this.submitBtn) {
                        this.submitBtn.className = 'numpad-btn btn-submit-key btn-next-mode';
                        this.submitBtn.textContent = "下一題";
                    }
                    this.renderGrid();
                }
            }
        }
    }

    // ==========================================
    // 拔河物理拉扯與刻度定位系統
    // ==========================================
    function getStepDistance() {
        const scaleContainer = document.getElementById('scale-ticks-container');
        if (!scaleContainer) return 48;
        const ticks = scaleContainer.querySelectorAll('.tick-dot');
        if (ticks.length >= 11) {
            const rectFirst = ticks[0].getBoundingClientRect();
            const rectLast = ticks[10].getBoundingClientRect();
            const totalDist = (rectLast.left + rectLast.width / 2) - (rectFirst.left + rectFirst.width / 2);
            return totalDist / 10;
        }
        return 48;
    }

    function applyTugMove(actorPlayerId, dir) {
        if (tugState.isGameOver) return;

        if (actorPlayerId === 1) {
            tugState.position += (dir === 1 ? -1 : +1);
        } else {
            tugState.position += (dir === 1 ? +1 : -1);
        }

        if (tugState.position < -MAX_STEPS) tugState.position = -MAX_STEPS;
        if (tugState.position > MAX_STEPS) tugState.position = MAX_STEPS;

        Sound.pull();
        updateTugStadiumUI(actorPlayerId, dir);

        if (tugState.position <= -MAX_STEPS) {
            declareWinner(1);
        } else if (tugState.position >= MAX_STEPS) {
            declareWinner(2);
        }
    }

    function triggerPullEffortAnimation(pullingPlayerId) {
        const team1 = document.getElementById('team-p1');
        const team2 = document.getElementById('team-p2');
        const sweat1 = document.getElementById('sweat-p1');
        const sweat2 = document.getElementById('sweat-p2');

        if (pullingPlayerId === 1) {
            team1.classList.remove('strain-left');
            void team1.offsetWidth;
            team1.classList.add('strain-left');

            sweat1.parentElement.classList.remove('show-sweat');
            void sweat1.parentElement.offsetWidth;
            sweat1.parentElement.classList.add('show-sweat');
        } else {
            team2.classList.remove('strain-right');
            void team2.offsetWidth;
            team2.classList.add('strain-right');

            sweat2.parentElement.classList.remove('show-sweat');
            void sweat2.parentElement.offsetWidth;
            sweat2.parentElement.classList.add('show-sweat');
        }
    }

    function updateTugStadiumUI(actorPlayerId, dir) {
        const ropeAssembly = document.getElementById('rope-assembly');
        const statusText = document.getElementById('stadium-status-text');
        const meterLblP1 = document.getElementById('meter-lbl-p1');
        const meterLblP2 = document.getElementById('meter-lbl-p2');
        const meterP1 = document.getElementById('meter-p1');
        const meterP2 = document.getElementById('meter-p2');

        const stepPx = getStepDistance();
        const shiftX = tugState.position * stepPx;
        ropeAssembly.style.setProperty('--cur-shift', `${shiftX}px`);
        ropeAssembly.style.transform = `translateX(${shiftX}px)`;

        if (actorPlayerId) {
            const isPullingLeft = (actorPlayerId === 1 && dir === 1) || (actorPlayerId === 2 && dir === -1);
            ropeAssembly.classList.remove('pull-anim-left', 'pull-anim-right');
            void ropeAssembly.offsetWidth;
            ropeAssembly.classList.add(isPullingLeft ? 'pull-anim-left' : 'pull-anim-right');

            triggerPullEffortAnimation(isPullingLeft ? 1 : 2);
        }

        renderScaleTicks();

        let leftRemaining = MAX_STEPS + tugState.position;
        let rightRemaining = MAX_STEPS - tugState.position;
        meterLblP1.textContent = `◀ ${tugState.team1.name} (剩 ${leftRemaining} 格獲勝)`;
        meterLblP2.textContent = `${tugState.team2.name} (剩 ${rightRemaining} 格獲勝) ▶`;

        let bluePercent = ((MAX_STEPS - tugState.position) / (MAX_STEPS * 2)) * 100;
        let redPercent = 100 - bluePercent;
        meterP1.style.width = `${bluePercent}%`;
        meterP2.style.width = `${redPercent}%`;

        if (tugState.position < 0) {
            statusText.innerHTML = `局勢：<b style="color:#54a0ff">${tugState.team1.icon} ${tugState.team1.name} 領先 ${Math.abs(tugState.position)} 格！</b>`;
        } else if (tugState.position > 0) {
            statusText.innerHTML = `局勢：<b style="color:#ff6b6b">${tugState.team2.icon} ${tugState.team2.name} 領先 ${tugState.position} 格！</b>`;
        } else {
            statusText.textContent = "當前局勢：勢均力敵 (中線 0 格)";
        }
    }

    function renderScaleTicks() {
        const container = document.getElementById('scale-ticks-container');
        container.innerHTML = '';
        for (let step = -MAX_STEPS; step <= MAX_STEPS; step++) {
            const dot = document.createElement('div');
            dot.className = 'tick-dot';
            if (step === tugState.position) {
                dot.classList.add('active');
            }
            container.appendChild(dot);
        }
    }

    function declareWinner(winnerId) {
        tugState.isGameOver = true;
        Sound.win();

        players.forEach(p => p.stopTimer());

        const overlay = document.getElementById('win-overlay');
        const title = document.getElementById('win-title');
        const sub = document.getElementById('win-sub');

        const winningTeam = winnerId === 1 ? tugState.team1 : tugState.team2;
        title.innerHTML = `🏆 <span style="color:${winnerId === 1 ? '#54a0ff' : '#ff7675'}">${winningTeam.icon} ${winningTeam.name}</span> 拔河獲勝！`;
        sub.textContent = `力拔山兮氣蓋世！${winningTeam.name}成功將紅絲帶標記拉過獲勝終點線！🎉`;
        overlay.classList.add('show');
    }

    let players = [];

    function initApp() {
        pickRandomTeams();
        renderTeamMembers();
        renderScaleTicks();

        players = [new MatchPlayer(1), new MatchPlayer(2)];

        document.getElementById('sel-level').addEventListener('change', (e) => {
            matchConfig.level = parseInt(e.target.value);
            restartMatch();
        });

        window.addEventListener('resize', () => {
            updateTugStadiumUI();
        });

        setTimeout(() => {
            updateTugStadiumUI();
        }, 60);
    }

    function restartMatch() {
        document.getElementById('win-overlay').classList.remove('show');
        tugState.position = 0;
        tugState.isGameOver = false;

        // 重新抽取奇幻陣營角色
        pickRandomTeams();
        renderTeamMembers();

        const ropeAssembly = document.getElementById('rope-assembly');
        ropeAssembly.style.setProperty('--cur-shift', `0px`);
        ropeAssembly.style.transform = `translateX(0px)`;
        ropeAssembly.classList.remove('pull-anim-left', 'pull-anim-right');

        document.getElementById('stadium-status-text').textContent = "當前局勢：勢均力敵 (中線 0 格)";
        document.getElementById('meter-p1').style.width = "50%";
        document.getElementById('meter-p2').style.width = "50%";
        renderScaleTicks();

        players.forEach(p => {
            p.stopTimer();
            p.generateNewQuestion();
        });

        updateTugStadiumUI();
    }

    window.onload = initApp;
</script>
